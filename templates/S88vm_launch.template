{{ if isEndpoint .Node }}
{{ info "### vm_launch ###" }}

{{ $name := (or .Node.D.name "") }}

{{ if eq $name "" }}
	{{ $name = printf "discovery-node-%v" .Node.NID }}
	{{ setData .Node "name" $name }}
{{ end }}

{{ if eq (or .Node.D.type "") "qemu" }}
	vm launch kvm {{ $name }}
{{ else if eq (or .Node.D.type "") "android" }}
	vm launch android {{ $name }}
{{ else }}
	vm launch container {{ $name }}
{{ end }}

{{ end }}
